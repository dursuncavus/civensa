# Local development example; this file is not loaded automatically.
CIVENSA_ENV=development
SESSION_SECRET=
COOKIE_SECURE=0
DEMO_SEED=0
# Per-IP login locking is disabled by default because Render's proxy address is
# shared. Set a positive integer only when request.client.host identifies users.
CIVENSA_LOGIN_IP_LIMIT=0
# PostgreSQL example (replace placeholders; never commit real credentials):
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE
# Optional separate migration owner; requests still use DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql+psycopg://civensa_owner:PASSWORD@HOST:5432/DATABASE
# See docs/operations/db-roles.md. Unset preserves pilot behaviour.
# Production: CIVENSA_ENV=production, COOKIE_SECURE=1 and a random
# SESSION_SECRET of at least 32 characters. Inject these through your runtime.
