# Local development example; this file is not loaded automatically.
CIVENSA_ENV=development
SESSION_SECRET=
COOKIE_SECURE=0
DEMO_SEED=0
# PostgreSQL example (replace placeholders; never commit real credentials):
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE
# Production: CIVENSA_ENV=production, COOKIE_SECURE=1 and a random
# SESSION_SECRET of at least 32 characters. Inject these through your runtime.
